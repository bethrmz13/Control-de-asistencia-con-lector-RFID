<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f2772843-2bb5-4156-bfcb-86bee218884f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_FECHA" class="java.lang.String"/>
	<parameter name="P_GRUPO_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT c.nombre AS carrera,
       s.nivel AS nivel, 
       s.nombre AS asignatura, 
       g.paralelo AS paralelo,
       COALESCE(u.nombre, 'Sin docente') AS docente,
       e.apellido, 
       e.nombre, 
       h.hora_inicio, 
       a.hora AS hora_llegada,
       IF(a.id IS NULL, 'FALTA', 'PRESENTE') AS estado
FROM grupo g
JOIN asignatura s ON s.id = g.asignatura_id
JOIN carrera c ON c.id = s.carrera_id
LEFT JOIN usuario u ON u.id = g.docente_id
JOIN matricula m ON m.grupo_id = g.id
JOIN estudiante e ON e.id = m.estudiante_id
JOIN horario h ON h.grupo_id = g.id
LEFT JOIN asistencia a ON a.estudiante_id = e.id
                      AND a.horario_id = h.id
                      AND a.fecha = $P{P_FECHA}
WHERE g.id = $P{P_GRUPO_ID}
  AND h.dia_semana = WEEKDAY($P{P_FECHA}) + 1
ORDER BY e.apellido, e.nombre;]]>
	</queryString>
	<field name="carrera" class="java.lang.String"/>
	<field name="nivel" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="asignatura" class="java.lang.String"/>
	<field name="paralelo" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="docente" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nombre" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hora_inicio" class="java.sql.Time">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hora_llegada" class="java.sql.Time"/>
	<field name="estado" class="java.lang.String"/>
	<variable name="VP" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{estado}.equals("PRESENTE") ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="VF" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{estado}.equals("FALTA") ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
